// .vscode/launch.json
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug git hash-object",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/git",
      "args": ["hash-object", "-w", "hello.txt"],
      "stopAtEntry": false, // 是否在main函数入口暂停
      "cwd": "${workspaceFolder}", // 工作目录
      "environment": [], // 环境变量
      "externalConsole": false, // 使用集成终端
      "MIMode": "gdb", // 调试器类型
      "miDebuggerPath": "/usr/bin/gdb", // GDB路径
      "preLaunchTask": "build-project" // 调试前执行构建任务
    }
  ]
}